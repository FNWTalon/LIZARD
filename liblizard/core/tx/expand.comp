// ai: A frame of the sender's ring (grey, four pixels a u32, rows `rw` words apart from word `base`) expanded into an
// ai: RGBA8 image (the grey in R, G and B, opaque), the desktop presenter's picture to blit on screen (2026-10-07):
// ai: no host copy on the way from the painter to the swapchain. rgba8's store rounds g * 255 back to the byte.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) readonly buffer F { uint words[]; } frame;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D pic;
layout(push_constant) uniform P { uint base; uint rw; uint w; uint h; } p;
void main() {
  uvec2 q = gl_GlobalInvocationID.xy;
  if (q.x >= p.w || q.y >= p.h) return;
  uint word = frame.words[p.base + q.y * p.rw + (q.x >> 2u)];
  float g = float((word >> (8u * (q.x & 3u))) & 0xffu) / 255.0;
  imageStore(pic, ivec2(q), vec4(g, g, g, 1.0));
}
